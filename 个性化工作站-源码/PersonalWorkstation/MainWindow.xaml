<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PersonalWorkstation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="个性化工作站"
        Height="860" Width="1360" MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ① 顶部栏 -->
    <Border Grid.Row="0" Background="{DynamicResource TopBarBg}" Height="52"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Style="{StaticResource IconButton}" Margin="12,0,4,0"
                Command="{Binding ToggleNavVisibleCommand}" ToolTip="显示 / 隐藏左侧导航栏">
          <TextBlock Style="{StaticResource Glyph}" FontSize="16" Text="&#xE700;"/>
        </Button>

        <TextBlock Grid.Column="1" Text="个性化工作站" FontSize="15" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="4,0,0,0"/>

        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Margin="0,0,16,0" Foreground="{DynamicResource TextSecondary}" Text="{Binding TodayText}"/>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Style="{StaticResource Glyph}" FontSize="10" Text="&#xE73E;" Margin="0,0,6,0"
                     Foreground="{DynamicResource Success}" x:Name="SaveDot"/>
          <TextBlock Text="{Binding SaveStatusText}" VerticalAlignment="Center" FontSize="12"
                     Foreground="{DynamicResource TextSecondary}" Margin="0,0,14,0"/>

          <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}"
                  ToolTip="{Binding ThemeLabel, StringFormat=主题：{0}（点击切换）}">
            <TextBlock Style="{StaticResource Glyph}" FontSize="15" Text="&#xE706;"/>
          </Button>

          <Button Style="{StaticResource IconButton}" Command="{Binding ToggleNavCollapsedCommand}"
                  ToolTip="折叠 / 展开导航栏"
                  Visibility="{Binding NavVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource Glyph}" FontSize="14" Text="{Binding NavCollapseGlyph}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ② 主体 -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding NavColumnWidth}"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 左侧导航栏 -->
      <Border Grid.Column="0" Background="{DynamicResource NavBg}"
              BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,1,0"
              Visibility="{Binding NavVisible, Converter={StaticResource BoolToVis}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- 可滚动部分：分组 + 模块 -->
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,6,0,6">
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <Border Visibility="{Binding HeaderVisibility}">
                      <ToggleButton Style="{StaticResource GroupHeaderToggle}" Content="{Binding Title}"
                                    IsChecked="{Binding IsExpanded, Mode=TwoWay}"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding ItemsVisibility}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Style="{StaticResource NavItemButton}" Command="{Binding SelectCommand}"
                                  ToolTip="{Binding Title}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                              <TextBlock Style="{StaticResource NavIcon}" Text="{Binding Icon}"/>
                              <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding DataContext.ShowNavText, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- 固定底部：数据与设置 -->
          <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelBorder}"
                  Padding="0,6,0,8">
            <Button Style="{StaticResource NavItemButton}" DataContext="{Binding PinnedItem}"
                    Command="{Binding SelectCommand}" ToolTip="{Binding Title}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource NavIcon}" Text="{Binding Icon}"/>
                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding DataContext.ShowNavText, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
              </StackPanel>
            </Button>
          </Border>
        </Grid>
      </Border>

      <!-- 右侧内容区 -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TopBarBg}"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
          <StackPanel Margin="24,14,24,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding ModuleTitle}" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding ModuleSummary}" Margin="12,0,0,2" VerticalAlignment="Bottom"
                         Foreground="{DynamicResource TextMuted}" FontSize="12"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding VisibleTabs}" Margin="0,10,0,0"
                          Visibility="{Binding ShowTabs, Converter={StaticResource BoolToVis}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource TabButton}" Content="{Binding Title}" Command="{Binding SelectCommand}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
      </Grid>
    </Grid>

    <!-- ③ 状态栏 -->
    <Border Grid.Row="2" Background="{DynamicResource StatusBg}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Padding="14,5">
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE8B7;"
                     Foreground="{DynamicResource TextMuted}" Margin="0,0,6,0"/>
          <Button Style="{StaticResource LinkButton}" Command="{Binding OpenDataFolderCommand}"
                  ToolTip="{Binding DataFileDisplay}">
            <TextBlock Text="{Binding DataFileDisplay, StringFormat=数据文件：{0}}"
                       Foreground="{DynamicResource TextSecondary}" FontSize="12"/>
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock Text="{Binding BackupCountText}" Style="{StaticResource Dim}"/>
          <TextBlock Text="·" Style="{StaticResource Dim}" Margin="8,0"/>
          <TextBlock Text="{Binding SaveStatusText}" Style="{StaticResource Dim}"/>
          <TextBlock Text="·" Style="{StaticResource Dim}" Margin="8,0"/>
          <TextBlock Text="{Binding VersionText}" Style="{StaticResource Dim}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>