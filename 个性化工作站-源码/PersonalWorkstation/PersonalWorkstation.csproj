<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PersonalWorkstation</RootNamespace>
    <AssemblyName>PersonalWorkstation</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyTitle>个性化工作站</AssemblyTitle>
    <Product>个性化工作站</Product>
    <FileDescription>个性化工作站</FileDescription>
    <Company>personal</Company>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 显式指定平台标识，避免 MSBuild 去探测本机 Windows SDK 目录 -->
    <TargetPlatformMoniker>Windows,Version=7.0</TargetPlatformMoniker>
    <TargetPlatformDisplayName>Windows</TargetPlatformDisplayName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

</Project>